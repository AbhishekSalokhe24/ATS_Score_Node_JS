{
    "info": {
        "name": "ATS Score Api Collection",
        "description": "ATS Score Check API — All endpoints (Auth, and future APIs)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:5000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        },
        {
            "key": "jobId",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Sign Up",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/signup",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "signup"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"username\": \"johndoe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Test@1234\"\n}"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "if (pm.response.code === 201) {",
                            "    const res = pm.response.json();",
                            "    pm.collectionVariables.set('token', res.token);",
                            "    pm.test('Sign Up successful', () => {",
                            "        pm.expect(res.success).to.be.true;",
                            "        pm.expect(res.token).to.be.a('string');",
                            "    });",
                            "}"
                        ]
                    }
                }
            ],
            "response": []
        },
